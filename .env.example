# Docker Compose 로컬 발표용 환경변수
# 복사: Copy-Item .env.example .env

ADMIN_USERNAME=admin
# 아래 명령으로 생성한 bcrypt 해시를 입력하세요. Compose .env에서는 각 '$'를
# '$$'로 바꿔야 Compose가 해시를 그대로 컨테이너에 전달합니다.
# server\.venv\Scripts\python.exe server\scripts\make_password_hash.py "발표용 비밀번호"
ADMIN_PASSWORD_HASH=

# 개발용 기본값입니다. 운영(Railway)에서는 반드시 별도 무작위 값으로 교체합니다.
JWT_SECRET=compose-development-only-change-me
INGEST_API_KEY=compose-development-ingest-key
