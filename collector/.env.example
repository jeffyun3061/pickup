# API의 절대 주소 (운영에서는 Railway private URL 또는 HTTPS public URL)
INGEST_SERVER_URL=http://127.0.0.1:8000
INGEST_API_KEY=replace-with-server-ingest-key

# robots.txt·서버 로그에서 식별되는 UA. 연락 수단을 남기는 것을 권장.
# COLLECTOR_USER_AGENT=GamePickupBot/1.0 (+contact@example.com)

# 공식 API 소스의 secret_env_name과 같은 이름으로 실제 토큰을 설정한다.
# GAME_NEWS_API_TOKEN=
