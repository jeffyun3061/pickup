# 복사: copy .env.example .env
APP_NAME=GamePickup API
ENV=development
# 로컬: `scripts/run_local_pg_api.py`가 Docker 없이 PostgreSQL을 시작한다. 운영은
# Railway 관리형 PostgreSQL 주소로 교체한다.
DATABASE_URL=postgresql+psycopg://gamepickup:gamepickup_dev@127.0.0.1:5432/gamepickup
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# 관리자 (본인만). 해시 생성:
# python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('YOUR_PASSWORD'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# production은 UTF-8 기준 32바이트 이상 무작위 값 필수
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# 자동화(RSS/AI)용 — production은 UTF-8 기준 32바이트 이상 무작위 값 필수
INGEST_API_KEY=change-me-ingest-key

# collector는 같은 INGEST_API_KEY를 환경변수로 받고 별도 프로세스로 실행한다.
# 외부 공식 API 토큰은 해당 소스의 secret_env_name과 같은 collector 환경변수에만 둔다.

# LLM 요약 (비우면 규칙 기반 요약으로 폴백, 자동 발행은 요약 성공 시에만)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# 일일 요약 호출 상한 (비용 폭주 방지)
SUMMARIZE_DAILY_LIMIT=300

# 개발: false면 스텁(로그만). 운영 ENV=production에서는 true 필수
EXPO_PUSH_ENABLED=false
# 조용시간(심야 푸시를 아침으로 미룸). start == end 이면 비활성
QUIET_HOURS_START=23
QUIET_HOURS_END=8
QUIET_HOURS_UTC_OFFSET=9

# 주기 작업 러너 (로컬 개발은 false, 운영 ENV=production에서는 true 필수)
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
# collector가 죽었을 때 running 작업을 회수할 시간(분)
INGEST_STALE_AFTER_MINUTES=45

# 앱 최소 지원 버전 (semver). 비우면 강제 업데이트 게이트 없음
MIN_APP_VERSION=

# 업로드 이미지 저장 경로. 프로덕션(Railway)은 볼륨 마운트 경로: /data/media
MEDIA_DIR=./media
# 관리자 웹 빌드 경로 — 존재하면 /admin 으로 same-origin 서빙 (Docker 이미지는 /app/admin-dist)
ADMIN_DIST_DIR=../admin/dist
# 운영 개인정보처리방침에 표시할 문의 이메일 (production 필수)
# 운영 문의 이메일을 실제 주소로 지정 (production 필수; example.com 금지)
PRIVACY_CONTACT_EMAIL=
