# 복사: copy .env.example .env
APP_NAME=GamePickup API
ENV=development
DATABASE_URL=sqlite:///./gamepickup.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081

# 관리자 (본인만). 해시 생성:
# python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt']).hash('YOUR_PASSWORD'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# 자동화(RSS/AI)용 — draft만 생성 가능
INGEST_API_KEY=change-me-ingest-key
