# 수집기(collector) 이미지 — API의 ingest 엔드포인트를 폴링해 소스를 수집
# Railway: 서비스 Dockerfile Path = Dockerfile.collector
# 필수 환경변수: INGEST_API_KEY, INGEST_SERVER_URL (API 서비스 내부 주소)

FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY collector/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt \
    && python -m playwright install --with-deps chromium

COPY collector/ ./collector/

CMD ["python", "-m", "collector.runner", "--poll-seconds", "30"]
