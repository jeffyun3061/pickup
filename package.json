{
  "name": "gamepickup",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@expo-google-fonts/ibm-plex-sans-kr": "^0.4.1",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.11",
    "expo-constants": "~57.0.9",
    "expo-font": "~57.0.1",
    "expo-haptics": "^57.0.1",
    "expo-linear-gradient": "^57.0.1",
    "expo-linking": "~57.0.5",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "start": "set NODE_OPTIONS=--dns-result-order=ipv4first&& expo start --dev-client --host localhost --port 8081",
    "android": "set NODE_OPTIONS=--dns-result-order=ipv4first&& expo start --dev-client --host localhost --port 8081 --android",
    "ios": "set NODE_OPTIONS=--dns-result-order=ipv4first&& expo start --dev-client --host localhost --port 8081 --ios",
    "web": "expo start --web --port 8081",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test"
  },
  "private": true
}
